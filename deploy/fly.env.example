# Copy values into: fly secrets set KEY=value ...
# Replace vault host with your Cloudflare Pages URL (custom domain or *.pages.dev)

JWT_SECRET=generate-with-openssl-rand-hex-32
OMNISECURE_PUBLIC_URL=https://omnisecure-vault.pages.dev
OMNISECURE_API_URL=https://omnisecure-api.fly.dev
WEBAUTHN_RP_ID=omnisecure-vault.pages.dev
WEBAUTHN_ORIGIN=https://omnisecure-vault.pages.dev
WEBAUTHN_RP_NAME=OmniSecure
